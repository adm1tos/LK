# SSH mode
# 1 = тестовый режим через одну VM и проброшенный порт. остаточный для разработки...
# 0 = обычный режим: IP VM берётся из Proxmox через QEMU Guest Agent
SSH_TEST_MODE=1

# SSH user for normal mode
SSH_ADMIN_USER=lkadmin
SSH_ADMIN_PORT=22
SSH_CONNECT_TIMEOUT=10
SSH_COMMAND_TIMEOUT=15

